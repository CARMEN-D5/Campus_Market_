Content-Type: application/json

{
  "username": "Carmen",
  "password": "pw1234"
}

> {%  client.global.set("auth_token", response.body.token); %}

### Get current user
GET http://localhost:8080/api/auth/me
Authorization: Bearer {{auth_token}}

